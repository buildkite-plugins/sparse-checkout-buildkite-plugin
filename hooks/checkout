#!/usr/bin/env bash

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/shared.bash
. "$DIR/../lib/shared.bash"

# shellcheck source=lib/plugin.bash
. "$DIR/../lib/plugin.bash"

# Set up error trapping for better error logs
setup_error_trap

VERBOSE_OPTION="$(plugin_read_config VERBOSE "false")"
[[ "${VERBOSE_OPTION}" = "true" ]] && set -x

NO_CONE_OPTION="$(plugin_read_config NO_CONE "false")"
NO_CONE_PARAM=""
[[ $NO_CONE_OPTION = false ]] || NO_CONE_PARAM="--no-cone"

if plugin_read_list_into_result PATHS; then
  CHECKOUT_PATHS=("${result[@]}")
else
  log_error "Missing 'paths' option in the plugin configuration"
  exit 1
fi

SKIP_SSH_KEYSCAN_OPTION="$(plugin_read_config SKIP_SSH_KEYSCAN "false")"
CLEAN_CHECKOUT_OPTION="$(plugin_read_config CLEAN_CHECKOUT "false")"

MERGE_REF_RETRY_ATTEMPTS="$(plugin_read_config MERGE_REF_RETRY_ATTEMPTS "3")"
# Opt-in retry for the clone and commit fetch (see retry_with_backoff)
FETCH_ATTEMPTS="$(plugin_read_config FETCH_ATTEMPTS "1")"

# Usage: validate_attempts fetch_attempts "${FETCH_ATTEMPTS}" 1
validate_attempts() {
  if [[ ! "$2" =~ ^(0|[1-9][0-9]*)$ ]] || (( $2 < $3 )); then
    log_error "$1 must be a whole number of at least $3, got '$2'"
    exit 1
  fi
}
validate_attempts merge_ref_retry_attempts "${MERGE_REF_RETRY_ATTEMPTS}" 0
validate_attempts fetch_attempts "${FETCH_ATTEMPTS}" 1

if [[ "${CLEAN_CHECKOUT_OPTION}" = "true" ]]; then
  log_warning "clean_checkout is enabled - this will destroy any local changes and reset the repository state"
elif [[ "${CLEAN_CHECKOUT_OPTION}" = "only-upon-failure" ]]; then
  log_info "clean_checkout is only-upon-failure - aggressive cleanup runs only if sparse-checkout or checkout fails"
fi

perform_aggressive_clean_checkout() {
  log_info "Clean checkout enabled - resetting repository state"
  # Remove lock files (prevents "another git process" errors)
  find .git -name "*.lock" -delete 2>/dev/null || true
  # Reset everything: index, working tree, and tracked files
  git reset --hard HEAD 2>/dev/null || true
  # Clean untracked and ignored files (after reset, including previously tracked files)
  git clean -ffxdq 2>/dev/null || true
}

setup_sparse_checkout_and_checkout() {
  log_info "Setting up sparse-checkout"
  if ! git sparse-checkout set ${NO_CONE_PARAM:+--no-cone} "${CHECKOUT_PATHS[@]}"; then
    log_error "Failed to configure sparse-checkout"
    return 1
  fi

  if [[ "${USE_MERGE_REFSPEC}" = "true" ]]; then
    log_info "Checking out merge ref for PR #${BUILDKITE_PULL_REQUEST}"
    if ! git checkout FETCH_HEAD; then
      log_error "Failed to checkout FETCH_HEAD"
      return 1
    fi
  else
    log_info "Checking out ${BUILDKITE_COMMIT}"
    if [[ ${BUILDKITE_COMMIT} = "HEAD" ]]; then
      if ! git checkout FETCH_HEAD; then
        log_error "Failed to checkout FETCH_HEAD"
        return 1
      fi
    elif ! git checkout "${BUILDKITE_COMMIT}"; then
      log_error "Failed to checkout ${BUILDKITE_COMMIT}"
      return 1
    fi
  fi

  return 0
}

if [[ -n "${BUILDKITE_REPO_SSH_HOST:-}" ]] && [[ "${SKIP_SSH_KEYSCAN_OPTION}" = "false" ]]; then
  log_info "Scanning SSH keys for ${BUILDKITE_REPO_SSH_HOST}"
  [[ -d ~/.ssh ]] || mkdir -p ~/.ssh

  # Use a temporary file to capture ssh-keyscan output
  tmp_file=$(mktemp)
  if retry 5 ssh-keyscan "${BUILDKITE_REPO_SSH_HOST}" >"$tmp_file"; then
    cat "$tmp_file" >>~/.ssh/known_hosts
    rm -f "$tmp_file"
    log_success "SSH keys scanned successfully"
  else
    rm -f "$tmp_file"
    log_error "Failed to scan SSH keys for ${BUILDKITE_REPO_SSH_HOST} after 5 retries"
    exit 1
  fi
else
  log_info "Skipped SSH keyscan"
fi

log_info "Creating sparse-checkout with paths: ${CHECKOUT_PATHS[*]}"

# Validate required environment variables
validate_required_config "BUILDKITE_REPO" "${BUILDKITE_REPO:-}"
validate_required_config "BUILDKITE_COMMIT" "${BUILDKITE_COMMIT:-}"

# clone the repo without checking out files if it does not exist already
if [[ ! -d .git ]]; then
  log_info "Cloning repository ${BUILDKITE_REPO}"
  if ! retry_with_backoff "${FETCH_ATTEMPTS}" git clone \
    --depth 1 \
    --filter=blob:none \
    --no-checkout \
    ${BUILDKITE_REPO_MIRROR:+--reference "$BUILDKITE_REPO_MIRROR"} \
    -v \
    "${BUILDKITE_REPO}" .; then
    log_error "Failed to clone repository"
    exit 1
  fi
  log_success "Repository cloned successfully"
fi

# Enable clean checkout option to deal with corrupted repository states
if [[ "${CLEAN_CHECKOUT_OPTION}" = "true" ]]; then
  perform_aggressive_clean_checkout
else
  git clean -ffxdq
fi

FETCH_FLAGS=()
if [[ -n "${BUILDKITE_GIT_FETCH_FLAGS:-}" ]]; then
  # Use read -a to split the flags safely and shellcheck-compliantly
  read -r -a FETCH_FLAGS <<<"${BUILDKITE_GIT_FETCH_FLAGS}"
fi

FETCH_FLAGS+=(--depth 1 origin)

FETCH_OUTPUT=""

is_missing_merge_ref_error() {
  local merge_ref="refs/pull/${BUILDKITE_PULL_REQUEST}/merge"
  [[ "${FETCH_OUTPUT}" == *"couldn't find remote ref ${merge_ref}"* ]] \
    || [[ "${FETCH_OUTPUT}" == *"not our ref ${merge_ref}"* ]]
}

MERGE_REF_WAIT=2

# Fetch merge ref once, printing git's output
fetch_merge_ref() {
  if FETCH_OUTPUT=$(git fetch "${FETCH_FLAGS[@]}" "${MERGE_REF}" 2>&1); then
    [[ -n "${FETCH_OUTPUT}" ]] && printf '%s\n' "${FETCH_OUTPUT}"
    return 0
  else
    local status=$?
    [[ -n "${FETCH_OUTPUT}" ]] && printf '%s\n' "${FETCH_OUTPUT}" >&2
    # GitHub may still be computing the merge ref: wait 2s, then 5s, instead of the doubling backoff
    if is_missing_merge_ref_error; then
      RETRY_AFTER="${MERGE_REF_WAIT}"
      MERGE_REF_WAIT=5
    fi
    return "${status}"
  fi
}

# Determine if we should use the pull request merge refspec
USE_MERGE_REFSPEC="false"
if [[ "${BUILDKITE_PULL_REQUEST_USING_MERGE_REFSPEC:-false}" = "true" ]] \
  && [[ -n "${BUILDKITE_PULL_REQUEST:-}" ]] \
  && [[ "${BUILDKITE_PULL_REQUEST}" != "false" ]]; then
  USE_MERGE_REFSPEC="true"
  MERGE_REF="refs/pull/${BUILDKITE_PULL_REQUEST}/merge"

  log_info "Fetching merge ref for PR #${BUILDKITE_PULL_REQUEST} from origin"

  fetch_status=0
  if (( MERGE_REF_RETRY_ATTEMPTS > 0 )); then
    retry_with_backoff "${MERGE_REF_RETRY_ATTEMPTS}" fetch_merge_ref || fetch_status=$?
  fi

  # A merge ref that is still missing falls back to the commit; any other error fails the job
  if (( fetch_status != 0 )) && ! is_missing_merge_ref_error; then
    log_error "Failed to fetch merge ref for PR #${BUILDKITE_PULL_REQUEST} from origin"
    exit "${fetch_status}"
  fi

  if (( fetch_status != 0 || MERGE_REF_RETRY_ATTEMPTS <= 0 )); then
    if [[ "${BUILDKITE_COMMIT}" = "HEAD" ]]; then
      log_warning "Merge ref ${MERGE_REF} was still unavailable; falling back to branch ${BUILDKITE_BRANCH}"
    else
      log_warning "Merge ref ${MERGE_REF} was still unavailable; falling back to ${BUILDKITE_COMMIT}"
    fi
    USE_MERGE_REFSPEC="false"
  fi
fi

if [[ "${USE_MERGE_REFSPEC}" != "true" ]]; then
  if [[ ${BUILDKITE_COMMIT} = "HEAD" ]]; then
    FETCH_FLAGS+=("${BUILDKITE_BRANCH}")
  else
    FETCH_FLAGS+=("${BUILDKITE_COMMIT}")
  fi

  log_info "Fetching ${BUILDKITE_COMMIT} from origin"
  fetch_status=0
  retry_with_backoff "${FETCH_ATTEMPTS}" git fetch "${FETCH_FLAGS[@]}" || fetch_status=$?
  if [[ "${fetch_status}" -ne 0 ]]; then
    log_error "Failed to fetch ${BUILDKITE_COMMIT} from origin"
    exit "${fetch_status}"
  fi
fi
log_success "Fetch completed successfully"

if [[ "${CLEAN_CHECKOUT_OPTION}" = "only-upon-failure" ]]; then
  if ! setup_sparse_checkout_and_checkout; then
    log_warning "Sparse-checkout or checkout failed; performing aggressive clean checkout and retrying"
    perform_aggressive_clean_checkout
    if ! setup_sparse_checkout_and_checkout; then
      exit 1
    fi
  fi
elif ! setup_sparse_checkout_and_checkout; then
  exit 1
fi
log_success "Sparse checkout completed successfully"
